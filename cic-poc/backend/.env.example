# LLM Configuration
LLM_PROVIDER=anthropic          # or "openai"
LLM_MODEL=claude-sonnet-5  # or "gpt-4o" for OpenAI

# API Keys (only need the one matching your LLM_PROVIDER)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...           # Optional, only if using openai provider

# Paths
DATA_PATH=./data/syriac_world
VECTOR_STORE_PATH=./vector_store
