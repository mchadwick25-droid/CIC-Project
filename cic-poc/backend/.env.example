# LLM Configuration
LLM_PROVIDER=anthropic
# Representative/Facilitator generation model. Haiku 4.5 shipped 2026-08-10
# and was reverted the same day - a SEQUENCING fix, not a reversal of the
# cost decision: this one setting governs solo AND table, and the table
# workstream measured a Haiku-only public-transcript isolation breach whose
# repair is in PR #10, not yet in main. See render.yaml for the full account
# and Ministry/Technology/Table/GO_LIVE_CHECKLIST_2026-08-10.md for the order
# the re-flip has to follow. The classifier tier is separate and hardcoded in
# get_monitoring_llm, so this does not change what the safety classifiers run.
LLM_MODEL=claude-sonnet-5
#
# LLM_PROVIDER=openai is currently NOT a working path, despite being an
# accepted value: app/graph/nodes.py builds Anthropic-shaped cache_control
# blocks unconditionally and hands them to ChatOpenAI. Fix or remove before
# relying on it as a fallback.

# API Keys (only need the one matching your LLM_PROVIDER)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...           # Optional, only if using openai provider

# Paths
# DATA_BASE_PATH is the real Settings field (DATA_PATH was dead legacy config
# that Settings silently ignored - removed 2026-08-09). Point it at an
# alternate data root only for candidate-tree runs; the app defaults to ./data
# DATA_BASE_PATH=./data
VECTOR_STORE_PATH=./vector_store

# Deployment
# Defaults to localhost dev origins only (see app/config.py). REQUIRED for
# any hosted deployment - the frontend's actual domain must be listed here
# or every request will be blocked by CORS. JSON array of allowed origins:
# CORS_ORIGINS=["https://your-tester-domain.example.com"]

# Set to true only to exercise the app's own mechanics (session flow,
# streaming, multi-world turn-taking) with zero API calls and zero cost -
# every response is a fixed placeholder, never for real testing.
# MOCK_LLM=true

# Set to true to save a full JSON transcript per session to backend/transcripts/
# (gitignored). Only enable for an actual tester pilot where the onboarding
# text already discloses this - never for a general/public deployment without
# that same disclosure existing first.
# PILOT_LOGGING_ENABLED=true

# Supabase (accounts, per-user activity/credit tracking - see
# supabase_schema.sql and app/auth.py). Leave unset for local dev/mock
# mode - every Supabase-dependent feature (sign-in enforcement, session
# caps, transcript persistence) is a no-op until both are set.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...   # the service_role key, NOT the anon key - keeps this server-side only
